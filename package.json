{
  "name": "@tsofist/stem",
  "version": "10.3.0",
  "description": "Core basics for TypeScript applications",
  "author": "Andrew Berdnikov <tsofistgudmen@gmail.com>",
  "license": "LGPL-3.0",
  "homepage": "https://github.com/tsofist/stem/",
  "main": "lib/index",
  "types": "lib/index",
  "type": "commonjs",
  "scripts": {
    "dev:watch": "tsc -p tsconfig.build.json --watch",
    "build": "rm -rf lib && tsc -p tsconfig.build.json",
    "format": "npm run lint:code -- --fix",
    "lint": "npm run lint:code && npm run lint:lock-file",
    "lint:code": "eslint . --cache --cache-location .cache/",
    "lint:lock-file": "lockfile-lint",
    "pkg:publish": "semantic-release --no-ci",
    "pkg:publish-test": "semantic-release --dry-run",
    "pkg:clean": "rm -rf lib .coverage .cache",
    "pkg:purge": "npm run pkg:clean && rm -rf node_modules",
    "prepare": "husky",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@total-typescript/ts-reset": "^0.6.1",
    "@vue/reactivity": "~3.5",
    "cron-parser": "^5.10",
    "pretty-ms": "^7.0",
    "tslib": "^2"
  },
  "devDependencies": {
    "@tsofist/web-buddy": "^2.0.0",
    "@types/jest": "~30.0",
    "@types/node": "^22.12",
    "@types/supertest": "^7",
    "husky": "^9.1",
    "jest": "~30.5",
    "supertest": "^7",
    "ts-jest": "^29.4",
    "typescript": "~6.0"
  },
  "peerDependencies": {},
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=22.12"
  },
  "release": {
    "extends": [
      "@tsofist/web-buddy/lib/semantic-release/config.github.js"
    ]
  },
  "lockfile-lint": {
    "type": "npm",
    "path": "package-lock.json",
    "allowedHosts": [
      "npm"
    ],
    "validateHttps": true,
    "validateIntegrity": true
  },
  "jest": {
    "cacheDirectory": ".cache",
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageDirectory": ".coverage",
    "coveragePathIgnorePatterns": [
      "types.ts"
    ],
    "moduleNameMapper": {},
    "roots": [
      "src"
    ],
    "setupFiles": [
      "./jest-setup.js"
    ],
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "lib",
    "!*.private.*",
    "!*.tmp.*"
  ],
  "keywords": [
    "tsofist",
    "stem",
    "lodash",
    "underscore"
  ]
}
